# Copy this file to `.env.local` and fill in real values.
# Without `NEXT_PUBLIC_TURNSTILE_SITE_KEY` the captcha widget renders
# NOTHING on the login page and the app falls back to a no-captcha mode.

# --- Supabase (https://supabase.com/dashboard -> your project -> Connect) ---
NEXT_PUBLIC_SUPABASE_URL=https://<your-project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=<your-anon-key>

# --- Cloudflare Turnstile (https://dash.cloudflare.com/?to=/:account/captcha) ---
# Public site key — safe to ship in the browser. THIS is what makes the
# captcha widget appear on the login page.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=<your-turnstile-site-key>

# Secret key — server-only. Used by src/lib/turnstile.ts to verify tokens.
TURNSTILE_SECRET_KEY=<your-turnstile-secret-key>

# The SAME Turnstile secret, required by Supabase GoTrue's captcha config
# ([auth.captcha] in supabase/config.toml). Set it to the same value.
SUPABASE_CAPTCHA_SECRET=<your-turnstile-secret-key>

# --- Google OAuth (https://console.cloud.google.com/apis/credentials) ---
# Client secret matching the client_id in supabase/config.toml.
AUTH_EXTERNAL_GOOGLE_SECRET=<your-google-oauth-secret>

# --- M-Pesa / Daraja API (https://developer.safaricom.co.ke) ---
# Required for billing and payment processing
MPESA_CONSUMER_KEY=<your-mpesa-consumer-key>
MPESA_CONSUMER_SECRET=<your-mpesa-consumer-secret>
MPESA_PASSKEY=<your-mpesa-passkey>
MPESA_SHORTCODE=<your-mpesa-shortcode>
MPESA_CALLBACK_URL=https://your-domain.com/api/webhooks/mpesa
MPESA_ENVIRONMENT=sandbox

# --- WorkOS AuthKit (migration) https://dashboard.workos.com ---
# Client id + secret key — use test keys for dev/staging.
WORKOS_API_KEY=<workos-secret-key>
WORKOS_CLIENT_ID=<workos-client-id>
# >= 32 chars, random. Signs the session cookie.
WORKOS_COOKIE_PASSWORD=<random-32+-char-password>
# Must match a registered redirect URI (templates: /auth/workos/callback).
WORKOS_REDIRECT_URI=http://localhost:3000/auth/workos/callback
NEXT_PUBLIC_WORKOS_REDIRECT_URI=http://localhost:3000/auth/workos/callback

# --- Convex (migration) https://dashboard.convex.dev ---
NEXT_PUBLIC_CONVEX_URL=https://<deployment>.convex.cloud
# Server/CLI admin key (dev deployment). Never use in client components.
CONVEX_ADMIN_KEY=<convex-admin-key>
CONVEX_DEPLOYMENT=<deployment-name-or-key>